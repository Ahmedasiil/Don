# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oenodpay

# Your site address, no trailing slash
APP_URL=http://localhost:3000

# Long random strings (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# First super admin (used by `pnpm db:seed`)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# Launch countries and currency
PAY_HOME_COUNTRIES=CA,US
PAY_BASE_CURRENCY=CAD

# Local only: add a demo customer when seeding
SEED_DEMO=false

# Provider keys are added in Admin, Plugin centre (not here).
